# Settings are read from environment variables (see triage/config.py).
# Everything is optional; uncomment a line only to override its default.
# docker compose can load a copy of this file named .env. Never commit a real .env.

# TRIAGE_DATA_DIR=<repo>/data
# TRIAGE_RUNBOOK_DIR=<repo>/vendor/sigma-detection-pack/runbooks
# TRIAGE_EMBEDDER=minilm          # minilm = real retrieval; hashing = offline test stand-in
# TRIAGE_EMBEDDING_MODEL_DIR=<repo>/models/all-MiniLM-L6-v2   # see scripts/fetch_embedding_model.py

# Model backend:
# TRIAGE_BACKEND=heuristic        # heuristic | ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=                   # required for the ollama backend; no default
# OLLAMA_THINK=                   # empty = not sent; true | false
